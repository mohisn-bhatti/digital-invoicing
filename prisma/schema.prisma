datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  CLIENT_USER
}

// Inside a client: Owner manages staff; Accountant does all invoicing work; Cashier only creates and prints invoices
enum TenantRole {
  OWNER
  ACCOUNTANT
  CASHIER
}

enum FbrEnv {
  SANDBOX
  PRODUCTION
}

enum InvoiceStatus {
  DRAFT
  QUEUED     // waiting for the background sender (FBR was unreachable, or from a bulk import); see nextAttemptAt
  SUBMITTING // a submission is in flight (acts as a lock against double submits)
  SUBMITTED
  FAILED     // FBR definitely did not record it; safe to retry
  UNCERTAIN  // connection broke after posting; FBR may have recorded it — check IRIS before resubmitting
  CANCELLED  // was filed, then cancelled in IRIS (recorded here so reports leave it out)
}

model User {
  id                 String      @id @default(uuid())
  email              String      @unique
  name               String      @default("")
  password           String
  role               Role        @default(CLIENT_USER)
  tenantRole         TenantRole  @default(OWNER) // only for CLIENT_USER
  active             Boolean     @default(true)
  pendingApproval    Boolean     @default(false) // added by a client owner: cannot log in until the administrator approves
  requestedBy        String?     // email of the owner who asked for this user
  tokenVersion       Int         @default(0)     // bump to log the user out everywhere (password change / reset / deactivate)
  mustChangePassword Boolean     @default(false) // set after an admin/owner reset
  failedLogins       Int         @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  tenantId           String?
  tenant             Tenant?     @relation(fields: [tenantId], references: [id])
  createdAt          DateTime    @default(now())
}

model Tenant {
  id                 String    @id @default(uuid())
  companyName        String
  // Seller block of every DI invoice
  sellerNtnCnic      String    @default("")  // the one number sent to FBR: the NTN, else the CNIC
  sellerNtn          String    @default("")
  sellerCnic         String    @default("")
  mobile             String    @default("")   // contact mobile: added by the admin or the client's owner
  active             Boolean   @default(true) // inactive: the client's users can't log in (admin can still manage it)
  sellerBusinessName String    @default("")
  sellerProvince     String    @default("")
  sellerAddress      String    @default("")
  // Sales tax registration no. — printed on invoices (STA s.23); not part of the DI API payload
  sellerStrn         String    @default("")
  tokenIssuedAt      DateTime? // FBR token is valid for 5 years (spec §3.1)
  irisScenarios   Json?    // sandbox scenarios as IRIS shows them (admin records): { assigned, passed, at, by }
  // PRAL security token, AES-256-GCM encrypted (src/crypto.js)
  fbrTokenEnc        String?
  fbrEnv             FbrEnv    @default(SANDBOX)
  // Further-tax % for unregistered buyers (4% confirmed by the CA)
  furtherTaxRate     Decimal   @default(4) @db.Decimal(5, 2)
  invoiceSeq         Int       @default(0)
  // As chosen in IRIS: decides the sandbox scenarios to pass (DI spec §10)
  businessActivities String[]  @default([])
  sectors            String[]  @default([]) // IRIS lets several be ticked
  modules            String[]  @default(["INVOICING"]) // products this client may use: INVOICING, POS (src/modules.js)
  // Internal invoice number printed next to the FBR number, e.g. INV-{YYYY}-{NNNN} → INV-2026-0042
  invoiceNumberFormat String   @default("INV-{YYYY}-{NNNN}")
  softwareRegNo      String    @default("") // software registration no. from PRAL/FBR, printed on receipts
  // Signed authorization (Form STR-13) letting the firm manage this client's FBR token / IRIS
  authLetterRef      String    @default("")
  authLetterAt       DateTime?
  // How long the client may use the application (src/subscription.js). No end date = no limit (every client before this existed).
  // Dates are Pakistan calendar days kept at 00:00 Pakistan time. When the end date plus the grace days (3 for a monthly plan,
  // 7 for a yearly one) has passed the client is made inactive by itself, and renewing it makes it active again.
  integratedAt       DateTime  @default(now()) // the day the client was integrated
  accessUnit         String?   // MONTH or YEAR: the length of the last period given (decides the grace days)
  accessCount        Int?      // how many of them
  accessEndsAt       DateTime? // the last day of access
  inactiveReason     String?   // why active is false: ADMIN (switched off by hand) or EXPIRED (the period ended)
  users              User[]
  invoices           Invoice[]
  products           Product[]
  buyers             Buyer[]
  importBatches      ImportBatch[]
  stockEntries       StockEntry[]
  drafts             InvoiceDraft[]
  createdAt          DateTime  @default(now())
  sandboxTests     SandboxTest[]
  supportTickets   SupportTicket[]
  // Point of Sale (PRA): its own tables and numbering, nothing shared with the FBR invoicing ones
  posSeq           Int           @default(0) // last USIN number handed out
  posProfile       PosProfile?
  posBranches      PosBranch[]
  posCounters      PosCounter[]
  posItems         PosItem[]
  posSales         PosSale[]
}

model Invoice {
  id                    String        @id @default(uuid())
  tenantId              String
  tenant                Tenant        @relation(fields: [tenantId], references: [id])
  localNo               Int
  invoiceNo             String        @default("") // formatted internal number (see Tenant.invoiceNumberFormat)
  fbrInvoiceNumber      String?       @unique
  status                InvoiceStatus @default(DRAFT)
  fbrEnv                FbrEnv
  invoiceType           String        @default("Sale Invoice")
  invoiceDate           String        // YYYY-MM-DD (Asia/Karachi), exactly as sent to FBR
  invoiceRefNo          String        @default("")
  // Debit notes: why it was issued (FBR error codes 0027/0028 require a reason; "Others" needs remarks)
  reason                String        @default("")
  reasonRemarks         String        @default("")
  scenarioId            String?
  buyerNtnCnic          String        @default("") // sent to FBR: the NTN if there is one, else the CNIC
  buyerNtn              String        @default("")
  buyerCnic             String        @default("")
  buyerStrn             String        @default("")
  buyerMobile           String        @default("")
  buyerEmail            String        @default("")
  buyerNote             String        @default("")
  buyerBusinessName     String
  buyerProvince         String
  buyerAddress          String
  buyerRegistrationType String
  // Unregistered + end consumer (walk-in): no further tax. FBR only knows Registered/Unregistered.
  endConsumer           Boolean       @default(false)
  // Registered buyer found not active (non-ATL): further tax applies like an unregistered buyer (STA s.3(1A))
  buyerNonAtl           Boolean       @default(false)
  totalExclST           Decimal       @db.Decimal(14, 2)
  totalST               Decimal       @db.Decimal(14, 2)
  totalFurtherTax       Decimal       @db.Decimal(14, 2)
  totalAmount           Decimal       @db.Decimal(14, 2)
  fbrRequest            Json?
  fbrResponse           Json?
  errorMessage          String?
  submittedAt           DateTime?
  // Idempotency: one id per form submission, so a resent request never creates a second invoice
  clientRequestId       String?
  submitAttempts        Int           @default(0)
  lastAttemptAt         DateTime?
  nextAttemptAt         DateTime?     // QUEUED: don't send before this (retry backoff)
  // Rule 150XC: issued while FBR/internet was down; must reach FBR within 24h of the outage
  offlineMode           Boolean       @default(false)
  offlineSince          DateTime?
  batchId               String?
  batch                 ImportBatch?  @relation(fields: [batchId], references: [id])
  importRef             String        @default("") // the client's own invoice number from the import file
  cancelledAt           DateTime?
  cancelNote            String        @default("") // what was done in IRIS / Commissioner approval reference
  items                 InvoiceItem[]
  createdAt             DateTime      @default(now())

  @@unique([tenantId, localNo])
  @@unique([tenantId, clientRequestId])
  @@index([tenantId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([batchId])
}

// One uploaded Excel/CSV file
model ImportBatch {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  fileName     String
  invoiceCount Int
  skipped      Int       @default(0) // invoices already imported earlier (same ref + date)
  invoices     Invoice[]
  createdAt    DateTime  @default(now())

  @@index([tenantId, createdAt])
}

// Items (the client's own list). An item appears on the invoice only once it has a tax rule; the current rule is
// copied onto the item (saleType … sroItemSerialNo) and every rule ever set is kept in ProductTaxRule.
model Product {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  name            String
  description     String   @default("")
  notes           String   @default("")
  hsCode          String
  hsDescription   String   @default("") // FBR's text for an official code; the client's for their own code
  source          String   @default("OFFICIAL") // OFFICIAL = picked from the FBR/PCT HS list; CUSTOMER = code typed by the client
  uoM             String
  unitPrice       Decimal? @db.Decimal(14, 2) // first of `prices`, kept for older screens and imports
  prices          Json     @default("[]")     // [{ label: "Retail", price: 150 }, …] — an item can have several prices
  // Current tax rule ("" = none yet: the item is not offered on invoices)
  saleType        String   @default("")
  rate            String   @default("")
  sroScheduleNo   String   @default("")
  sroItemSerialNo String   @default("")
  lawRefs         Json     @default("[]") // [{ reference, url, source, comment }] — the first is sent to FBR as the SRO / Schedule no.
  taxComment      String   @default("") // the client's note on the law for the sales tax (one per tax)
  fbrRateId       Int?     // rate id from FBR SaleTypeToRate (spec §5.8)
  fbrSroId        Int?     // SRO id from FBR SroSchedule (spec §5.7)
  extraTaxes      Json     @default("[]") // more taxes: [{ name, kind: PCT|FIXED, value, base, fbrField }] — src/tax.js
  notifiedRate    Decimal? @db.Decimal(14, 2) // notified price per unit; tax is charged on it instead of the actual price
  taxRuleAt       DateTime?
  taxRules        ProductTaxRule[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, name])
}

// Tax rule set by the client against an item (Phase 1: the client decides, ETAX only links the FBR guidance).
// Rules are never edited: a new rule replaces the current one and the old one stays as history.
model ProductTaxRule {
  id              String   @id @default(uuid())
  tenantId        String
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleType        String
  rate            String
  sroScheduleNo   String   @default("")
  sroItemSerialNo String   @default("")
  lawRefs         Json     @default("[]") // [{ reference, url, source, comment }] — the first is sent to FBR as the SRO / Schedule no.
  taxComment      String   @default("") // the client's note on the law for the sales tax (one per tax)
  fbrRateId       Int?     // rate id from FBR SaleTypeToRate (spec §5.8)
  fbrSroId        Int?     // SRO id from FBR SroSchedule (spec §5.7)
  extraTaxes      Json     @default("[]") // more taxes: [{ name, kind: PCT|FIXED, value, base, fbrField }] — src/tax.js
  notifiedRate    Decimal? @db.Decimal(14, 2)
  industry        String   @default("") // client's business nature / sector at the time (as chosen in IRIS)
  createdBy       String   @default("")
  createdAt       DateTime @default(now()) // date and time, picked automatically

  @@index([productId, createdAt])
}

// Saved customers. NTN, CNIC and STRN are kept separately; ntnCnic is the one number sent to FBR
// (the NTN if there is one, else the CNIC) and is null for unregistered buyers without a number.
model Buyer {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  businessName     String
  ntn              String   @default("")
  cnic             String   @default("")
  strn             String   @default("")
  ntnCnic          String?
  registrationType String   @default("Unregistered")
  province         String   @default("")
  address          String   @default("")
  mobile           String   @default("")
  email            String   @default("")
  note             String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([tenantId, ntnCnic])
  @@index([tenantId, businessName])
}

// HS / PCT codes for item lookup. Seeded from the 2017 PCT schedule (data/hs-codes-pct-2017.json),
// then overwritten from FBR's live itemdesccode list (source = "FBR") once a tenant has a working token.
model HsCode {
  code        String   @id // "0101.2100"
  description String
  source      String   @default("PCT-2017")
  updatedAt   DateTime @updatedAt
}

model InvoiceItem {
  id                              String  @id @default(uuid())
  invoiceId                       String
  invoice                         Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sNo                             Int
  hsCode                          String
  productDescription              String
  rate                            String  // e.g. "18%", as FBR's ratE_DESC
  uoM                             String
  quantity                        Decimal @db.Decimal(14, 4)
  unitPrice                       Decimal @db.Decimal(18, 6) // imports may derive it from the line value
  valueSalesExcludingST           Decimal @db.Decimal(14, 2)
  fixedNotifiedValueOrRetailPrice Decimal @default(0) @db.Decimal(14, 2)
  salesTaxApplicable              Decimal @db.Decimal(14, 2)
  salesTaxWithheldAtSource        Decimal @default(0) @db.Decimal(14, 2)
  extraTax                        Decimal @default(0) @db.Decimal(14, 2)
  furtherTax                      Decimal @default(0) @db.Decimal(14, 2)
  fedPayable                      Decimal @default(0) @db.Decimal(14, 2)
  extraTaxes                      Json    @default("[]") // the item's more taxes when filed
  extraTaxDetail                  Json    @default("[]") // [{ name, amount, fbrField }] — shown by name on the receipt
  discount                        Decimal @default(0) @db.Decimal(14, 2)
  totalValues                     Decimal @db.Decimal(14, 2)
  saleType                        String
  sroScheduleNo                   String  @default("")
  sroItemSerialNo                 String  @default("")

  @@index([invoiceId])
}

// Append-only record of who did what (FBR requires 6-year retention). The migration adds a trigger
// that rejects UPDATE / DELETE / TRUNCATE, so entries can't be altered or removed through the app or SQL.
model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?  // null = platform-level (super admin) action
  userId     String?  // null = system (background sender)
  userEmail  String   @default("system")
  action     String   // e.g. invoice.create, settings.update, auth.login_failed
  entityType String?
  entityId   String?
  summary    String
  details    Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([action])
}

// Contact-form enquiries from the public website (admin only)
model Lead {
  id           String   @id @default(uuid())
  name         String
  phone        String
  email        String   @default("")
  businessName String   @default("")
  city         String   @default("")
  businessType String   @default("")
  interest     String   @default("") // single invoices / bulk import / both
  message      String   @default("")
  status       String   @default("NEW") // NEW, CONTACTED, CLIENT, CLOSED
  notes        String   @default("")
  ip           String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
}

// Stock movements other than sales (sales come from filed invoices). Feeds the Annex-H1 stock statement.
enum StockEntryType {
  OPENING        // opening balance
  PURCHASE       // local purchase
  IMPORT         // imported goods (GD)
  ADJUSTMENT_IN  // e.g. stock count surplus
  ADJUSTMENT_OUT // e.g. damage, shortage, own use
}

model StockEntry {
  id          String         @id @default(uuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  entryType   StockEntryType
  entryDate   String         // YYYY-MM-DD
  hsCode      String
  uoM         String
  description String         @default("")
  quantity    Decimal        @db.Decimal(18, 4)
  value       Decimal        @db.Decimal(14, 2) // cost value (excl. sales tax)
  reference   String         @default("")       // supplier invoice / GD no.
  partyName   String         @default("")       // supplier
  notes       String         @default("")
  createdBy   String         @default("")
  createdAt   DateTime       @default(now())

  @@index([tenantId, entryDate])
  @@index([tenantId, hsCode])
}

// HS code → sale type / rate, from the Sales Tax Act schedules. Platform-wide, edited by the admin.
// The invoice form uses the rules with the longest prefix that matches the HS code. One code can have several rules,
// each with its own condition (e.g. "not in retail packing under a brand name" → exempt); the user then picks one.
model HsTaxRule {
  id              String   @id @default(uuid())
  prefix          String   // HS code digits, e.g. "3402" (heading) or "84713010" (one tariff line)
  condition       String   @default("") // when this rule applies; "" = always for this code
  saleType        String
  rate            String   @default("") // "" = keep the rate the user entered (e.g. fixed-amount regimes)
  sroScheduleNo   String   @default("")
  sroItemSerialNo String   @default("")
  note            String   @default("")
  source          String   @default("manual") // "manual", or where it was extracted from, e.g. "Sales Tax Act 30-06-2026"
  reviewed        Boolean  @default(false)    // checked by the CA
  updatedBy       String   @default("system")
  updatedAt       DateTime @updatedAt

  @@unique([prefix, condition])
  @@index([prefix])
}

// An invoice form saved before filing. Not an invoice: no number is used and nothing goes to FBR.
model InvoiceDraft {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  title       String   @default("") // buyer name, for the list
  data        Json     // the form as the browser had it
  totalAmount Decimal  @default(0) @db.Decimal(14, 2)
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, updatedAt])
}

// Buttons on the client's Tax Rules page linking to the law (Act PDF, schedules, SROs …). Edited by the admin.
model GuideLink {
  id        String   @id @default(uuid())
  label     String
  url       String
  sortOrder Int      @default(0)
  updatedBy String   @default("system")
  updatedAt DateTime @updatedAt
}

// Small platform-wide texts the admin can change, e.g. the note under the guideline buttons
model AppSetting {
  key       String   @id
  value     String
  updatedBy String   @default("system")
  updatedAt DateTime @updatedAt
}

// SROs, circulars, general orders and notices from fbr.gov.pk, copied daily so the Tax Rules page can search them
model LegalReference {
  id        String    @id @default(uuid())
  source    String    // ACT, RULES (Sales Tax Act / Rules editions), SRO, CIRCULAR, GENERAL_ORDER, NOTICE
  refNo     String    @default("") // e.g. "1751(I)/2026", "Circular No. 01 of 2026 (Sales Tax)"
  title     String
  issuedOn  DateTime?
  url       String
  fetchedAt DateTime  @default(now())

  @@unique([source, url])
  @@index([source, issuedOn])
}

// Sandbox scenario test invoices from the admin's "Run sandbox scenarios" — not the client's own invoices
model SandboxTest {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scenarioId       String
  ok               Boolean
  stage            String   // validate | post
  fbrInvoiceNumber String?
  error            String?
  request          Json?
  response         Json?
  createdBy        String
  createdAt        DateTime @default(now())

  @@index([tenantId, scenarioId])
}

// Help & feedback: a client's query and the replies between the client and the admin
model SupportTicket {
  id        String           @id @default(uuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userEmail String
  category  String           // Question | Problem | Suggestion | FBR / invoice | Other
  subject   String
  status    String           @default("OPEN") // OPEN (waiting for ETAX) | ANSWERED (waiting for the client) | RESOLVED
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt
  messages  SupportMessage[]

  @@index([tenantId, updatedAt])
  @@index([status])
}

model SupportMessage {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromAdmin Boolean
  author    String
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

// ---------- Point of Sale (PRA eIMS) ----------
// A separate product from Digital Invoicing: its own business profile, counters, items and sales. Every row carries tenantId.
enum PosEnv {
  SANDBOX
  PRODUCTION
}

// SRS v1.7 section 3. A sale is a completed fiscal invoice only once it is FISCALIZED.
enum PosSaleState {
  DRAFT
  AWAITING_FISCALIZATION
  OUTCOME_UNKNOWN
  FISCALIZED
  REJECTED
  CANCELLED
}

// What the receipt shows about the business (SRS 4.1: name, address, PNTN/NTN)
model PosProfile {
  tenantId      String   @id
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  businessName  String   @default("")
  pntn          String   @default("")
  address       String   @default("")
  phone         String   @default("")
  receiptFooter String   @default("")
  updatedAt     DateTime @updatedAt
}

model PosBranch {
  id        String       @id @default(uuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  name      String
  address   String       @default("")
  city      String       @default("")
  phone     String       @default("")
  active    Boolean      @default(true)
  counters  PosCounter[]
  createdAt DateTime     @default(now())

  @@unique([tenantId, name])
}

// One PRA-registered POS counter: its POS ID and Bearer token (encrypted, never sent to the browser)
model PosCounter {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  branchId   String
  branch     PosBranch @relation(fields: [branchId], references: [id])
  name       String
  posId      String
  env        PosEnv    @default(SANDBOX)
  tokenEnc   String?
  tokenSetAt DateTime?
  active     Boolean   @default(true)
  sales      PosSale[]
  createdAt  DateTime  @default(now())

  @@unique([tenantId, name])
  @@unique([tenantId, posId])
}

// What is sold: a service with its PCT code (Second Schedule) and tax rate
model PosItem {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  code        String
  name        String
  category    String   @default("")
  pctCode     String
  taxRate     Decimal  @db.Decimal(5, 2)
  taxRateCard Decimal? @db.Decimal(5, 2) // when set, used for card payments (restaurants pay less on card / QR)
  unitPrice   Decimal  @default(0) @db.Decimal(14, 2) // before tax
  openPrice   Boolean  @default(false) // the cashier types the price on each sale
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, name])
}

// A sale (invoiceType 1), or a credit note (3) that returns part of an earlier one. Never deleted: it is a tax record.
model PosSale {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  counterId      String
  counter        PosCounter     @relation(fields: [counterId], references: [id])
  invoiceType    Int            @default(1) // 1 New, 2 Debit, 3 Credit
  usin           String         // our own invoice number, handed out once and never reused (unique per business)
  clientRef      String?        // sent by the screen with each new sale: the same key twice gives back the sale already made, never a second one
  refUsin        String?        // credit note: the USIN of the sale it returns
  refSaleId      String?
  state          PosSaleState   @default(DRAFT)
  env            PosEnv         @default(SANDBOX)
  paymentMode    Int
  buyerName      String         @default("")
  buyerPntn      String         @default("")
  buyerCnic      String         @default("")
  buyerPhone     String         @default("")
  totalQuantity  Decimal        @db.Decimal(18, 4)
  totalSaleValue Decimal        @db.Decimal(14, 2)
  totalDiscount  Decimal        @db.Decimal(14, 2)
  totalTax       Decimal        @db.Decimal(14, 2)
  totalBill      Decimal        @db.Decimal(14, 2)
  fiscalNumber   String?        // PRA's invoice number
  lastCode       String?        // PRA's last answer code
  lastError      String?        // the last problem, in plain words
  payload        Json?          // exactly what was sent to PRA
  response       Json?          // PRA's last answer
  attempts       Int            @default(0)
  note           String         @default("")
  mock           Boolean        @default(false) // fiscal number came from test mode: not a real fiscal invoice
  createdBy      String
  createdAt      DateTime       @default(now())
  finalizedAt    DateTime?      // the sale time sent to PRA (SRS 4.6: kept apart from the times below)
  submittedAt    DateTime?
  respondedAt    DateTime?
  fiscalizedAt   DateTime?
  resolvedBy     String?
  resolvedAt     DateTime?
  lines          PosSaleLine[]
  events         PosSaleEvent[]
  tries          PosAttempt[]

  @@unique([tenantId, usin])
  @@unique([tenantId, clientRef])
  @@index([tenantId, state, fiscalizedAt]) // the alert counts, today's figures and "last fiscalized"
  @@index([tenantId, createdAt])
  @@index([refSaleId])
}

model PosSaleLine {
  id          String  @id @default(uuid())
  saleId      String
  sale        PosSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  sort        Int
  itemId      String?
  itemCode    String
  itemName    String
  pctCode     String
  quantity    Decimal @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(14, 2)
  discount    Decimal @db.Decimal(14, 2)
  taxRate     Decimal @db.Decimal(5, 2)
  saleValue   Decimal @db.Decimal(14, 2) // the value tax is charged on (after the discount)
  taxCharged  Decimal @db.Decimal(14, 2)
  totalAmount Decimal @db.Decimal(14, 2)
  refLineId   String? // credit note: the sold line it returns

  @@index([saleId])
  @@index([refLineId])
}

// Every change of state, who and why (SRS section 3: transitions must be recorded)
model PosSaleEvent {
  id        String   @id @default(uuid())
  saleId    String
  sale      PosSale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  at        DateTime @default(now())
  fromState String?
  toState   String
  by        String
  note      String   @default("")

  @@index([saleId])
}

// Every call to PRA and how it ended
model PosAttempt {
  id         String   @id @default(uuid())
  saleId     String
  sale       PosSale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  at         DateTime @default(now())
  durationMs Int
  outcome    String
  httpStatus Int?
  code       String?
  message    String   @default("")
  mock       Boolean  @default(false) // answered by test mode, not by PRA

  @@index([saleId])
  @@index([at]) // the latest answers, for the response-time figures
}
