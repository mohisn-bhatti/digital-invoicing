PORT=3000

# Development: local Postgres from `npm run db:local` (docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/fbr_billing"
DIRECT_URL="postgresql://postgres:postgres@localhost:54329/fbr_billing"

# Supabase (used only by `npm run supabase:deploy`, and as DATABASE_URL/DIRECT_URL on Render):
# Connect → ORMs → Prisma. Percent-encode special characters in the password (# → %23, $ → %24, % → %25).
SUPABASE_DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
SUPABASE_DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Generate both with: npm run gen:keys
JWT_SECRET=""
# 64 hex chars (32 bytes). Encrypts tenant FBR tokens at rest. Never change it after tokens are saved.
ENCRYPTION_KEY=""

# Used by `npm run seed` to create the first super admin and first tenant
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="change-me"
SEED_TENANT_NAME="My CA Firm"
SEED_TENANT_EMAIL="billing@example.com"
SEED_TENANT_PASSWORD="change-me"

# Static-IP proxy for FBR calls (e.g. QuotaGuard Static: http://user:pass@host:port).
# Needed on Render/Vercel because their default outbound IPs are shared and change. Empty = direct.
FBR_PROXY_URL=""

# true = don't call FBR; return a fake invoice number (for UI testing before IP whitelisting)
FBR_MOCK=true

# Website contact details (shown on raseed landing + contact pages; empty = hidden)
CONTACT_WHATSAPP=""   # international format, e.g. 923001234567
CONTACT_PHONE=""
CONTACT_EMAIL=""
CONTACT_CITY=""

# Backups (npm run backup). Encrypts each backup; keep this passphrase safe and separate from the backups.
BACKUP_PASSPHRASE=""
